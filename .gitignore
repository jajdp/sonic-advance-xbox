# Nothing that belongs to the game ever goes in here. Blocked by extension, so it cannot slip in
# by accident, and not as a substitute for reading NOTICE.md.

# ROM dumps and the asset archives built from them
*.z64
*.n64
*.v64
*.o2r
*.otr
*.zip
*.7z

# executables, debug info and packages
*.exe
*.dll
*.pdb
*.ilk
*.lib
*.obj
*.msix
*.msixbundle
*.appx
*.appxbundle
*.appxsym
*.appxupload

# signing certificates: yours is yours
*.pfx
*.p12
*.cer
*.snk
*_TemporaryKey.*

# saves and what the runtime writes beside itself
*.sav
*.srm
saves/
logs/
*.log

# build trees, in case this is cloned next to one
build/
build-*/
paquete-*/
.vs/

# Python
__pycache__/
*.py[cod]

# editors and OS
.vscode/
.idea/
*.swp
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# The package tiles are supplied by whoever packages (docs/ASSETS.md); no game art is
# distributed here.
package/Assets/*.png
